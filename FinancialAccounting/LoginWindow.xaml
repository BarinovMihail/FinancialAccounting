<Window x:Class="FinancialAccounting.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="540" Width="420"
        Background="#FFF4F7FB"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="#1F2937"
        ResizeMode="NoResize">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"        Color="#1565C0"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#0D47A1"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0A3276"/>
        <SolidColorBrush x:Key="GhostBrush"          Color="#EEF2F7"/>
        <SolidColorBrush x:Key="GhostHoverBrush"     Color="#E1E7EF"/>
        <SolidColorBrush x:Key="GhostPressedBrush"   Color="#D6DEE8"/>
        <SolidColorBrush x:Key="BorderBrush"         Color="#FFD7E0EA"/>
        <SolidColorBrush x:Key="MutedTextBrush"      Color="#FF6B7280"/>
        <SolidColorBrush x:Key="HeaderTextBrush"     Color="#FF111827"/>
        <SolidColorBrush x:Key="ErrorBrush"          Color="#D32F2F"/>

        <!-- Поле ввода -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле пароля -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка Primary -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                                  Opacity="0.18" Color="#1565C0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-ссылка -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Внешний фон -->
    <Grid>

        <!-- Карточка входа — по центру -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="372"
                Background="White"
                CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="30,36">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.10" Color="#000000"/>
            </Border.Effect>

            <StackPanel>

                <!-- Иконка -->
                <Border Width="56" Height="56"
                        Background="#EEF4FF"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <TextBlock Text="₽"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Заголовок -->
                <TextBlock Text="Финансовый учёт"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource HeaderTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Войдите в свой аккаунт"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Поле логина -->
                <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center">
                    <TextBlock Text="Логин"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="4,0,0,6"/>
                    <Grid>
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource InputStyle}"
                                 TextChanged="UsernameBox_TextChanged"/>
                        <TextBlock x:Name="UsernamePlaceholder"
                                   Text="Введите логин"
                                   FontSize="14"
                                   Foreground="#FFBBC3CE"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False"
                                   Visibility="Visible"/>
                    </Grid>
                </StackPanel>

                <!-- Поле пароля -->
                <StackPanel Margin="0,0,0,28" HorizontalAlignment="Center">
                    <TextBlock Text="Пароль"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="4,0,0,6"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource PasswordStyle}"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text="Введите пароль"
                                   FontSize="14"
                                   Foreground="#FFBBC3CE"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False"
                                   Visibility="Visible"/>
                    </Grid>
                </StackPanel>

                <!-- Кнопка входа -->
                <Button Content="Войти"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"
                        Click="LoginButton_Click"/>

                <!-- Ссылка на регистрацию -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Нет аккаунта? "
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="Зарегистрируйтесь"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="RegisterText_MouseDown"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Window>