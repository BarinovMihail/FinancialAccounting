<Window x:Class="FinancialAccounting.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить счёт" Height="360" Width="400"
        Background="#FFF4F7FB"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="#1F2937"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"        Color="#1565C0"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#0D47A1"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0A3276"/>
        <SolidColorBrush x:Key="BorderBrush"         Color="#FFD7E0EA"/>
        <SolidColorBrush x:Key="MutedTextBrush"      Color="#FF6B7280"/>
        <SolidColorBrush x:Key="HeaderTextBrush"     Color="#FF111827"/>

        <!-- Поле ввода -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                  Opacity="0.15" Color="#1565C0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE9EEF5"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD6DEE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Карточка-окно с тенью -->
    <Border Background="White"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6"
                              Opacity="0.12" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <!-- Titlebar -->
                <RowDefinition Height="*"/>
                <!-- Контент -->
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="16,16,0,0">
                <DockPanel Margin="16,0,8,0" LastChildFill="False">
                    <TextBlock Text="Добавление счёта"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <Button Content="×"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="White"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click">
                        <Button.Resources>
                            <!-- Переопределяем hover для белого фона на синем titlebar -->
                            <SolidColorBrush x:Key="GhostHoverBg" Color="#FF1976D2"/>
                        </Button.Resources>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Width="32" Height="32">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#331AABFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#550D47A1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Контент -->
            <StackPanel Grid.Row="1" Margin="28,20,28,28">

                <!-- Номер карты -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Номер карты"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="4,0,0,6"/>
                    <TextBox x:Name="CardNumberBox"
                             Style="{StaticResource InputStyle}"
                             PreviewTextInput="CardNumberBox_PreviewTextInput"
                             TextChanged="CardNumberBox_TextChanged"/>
                </StackPanel>

                <!-- Название банка -->
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="Название банка"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="4,0,0,6"/>
                    <TextBox x:Name="BankNameBox"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Кнопка -->
                <Button Content="Добавить счёт"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="AddAccount_Click"/>

            </StackPanel>
        </Grid>
    </Border>

</Window>