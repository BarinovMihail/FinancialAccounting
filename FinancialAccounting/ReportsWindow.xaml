<Window x:Class="FinancialAccounting.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёты" Height="640" Width="980"
        Background="#FFF4F7FB"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="#1F2937">

    <Window.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="PrimaryBrush"          Color="#1565C0"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush"     Color="#0D47A1"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush"   Color="#0A3276"/>
        <SolidColorBrush x:Key="SecondaryBrush"        Color="#E8F0FE"/>
        <SolidColorBrush x:Key="SecondaryHoverBrush"   Color="#D8E7FD"/>
        <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#C6DBFC"/>
        <SolidColorBrush x:Key="GhostBrush"            Color="#EEF2F7"/>
        <SolidColorBrush x:Key="GhostHoverBrush"       Color="#E1E7EF"/>
        <SolidColorBrush x:Key="GhostPressedBrush"     Color="#D6DEE8"/>
        <SolidColorBrush x:Key="SuccessBrush"          Color="#1F8A5B"/>
        <SolidColorBrush x:Key="SuccessHoverBrush"     Color="#187149"/>
        <SolidColorBrush x:Key="SuccessPressedBrush"   Color="#115537"/>
        <SolidColorBrush x:Key="DangerBrush"           Color="#D32F2F"/>
        <SolidColorBrush x:Key="DangerHoverBrush"      Color="#B71C1C"/>
        <SolidColorBrush x:Key="DangerPressedBrush"    Color="#8E1616"/>
        <SolidColorBrush x:Key="SurfaceBrush"          Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush"           Color="#FFD7E0EA"/>
        <SolidColorBrush x:Key="MutedTextBrush"        Color="#FF6B7280"/>
        <SolidColorBrush x:Key="HeaderTextBrush"       Color="#FF111827"/>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI card -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Base Button -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource GhostBrush}"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF3F6FA"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7FAFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8F0FE"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка + фильтры -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Итоги + действия -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — шапка + фильтры ═══ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="Отчёты"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource HeaderTextBrush}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="Фильтруйте транзакции и экспортируйте отчёт"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               DockPanel.Dock="Left"/>
                </DockPanel>

                <!-- Фильтры в одну строку -->
                <DockPanel Grid.Row="1" LastChildFill="False">

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Дата с -->
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Дата с" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker x:Name="StartDatePicker"
                                        Width="130" Height="34"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <!-- Дата по -->
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Дата по" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker x:Name="EndDatePicker"
                                        Width="130" Height="34"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <!-- Разделитель -->
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}"
                                   Margin="0,0,18,0" VerticalAlignment="Stretch"/>

                        <!-- Тип -->
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Тип" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="TypeComboBox"
                                      Width="130" Height="34"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}">
                                <ComboBoxItem Content="Все" IsSelected="True"/>
                                <ComboBoxItem Content="Доход"/>
                                <ComboBoxItem Content="Расход"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Категория -->
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Категория" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CategoryComboBox"
                                      Width="165" Height="34"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Кнопка применить — выровнена по нижнему краю фильтров -->
                    <Button DockPanel.Dock="Left"
                            Content="Применить"
                            Width="115"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,0"
                            Click="ApplyFilters_Click"/>

                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — таблица ═══ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="ReportDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Background="White"
                      Foreground="#1F2937"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FFF9FBFD"
                      RowBackground="White"
                      RowStyle="{StaticResource GridRowStyle}"
                      ColumnHeaderStyle="{StaticResource GridColumnHeader}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата"      Binding="{Binding Date}"        Width="130"/>
                    <DataGridTextColumn Header="Тип"       Binding="{Binding Type}"        Width="100"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}"    Width="*"/>
                    <DataGridTextColumn Header="Сумма"     Binding="{Binding Amount}"      Width="120"/>
                    <DataGridTextColumn Header="Описание"  Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ ROW 2 — итоги + действия ═══ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- KPI-плитки -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Кнопки -->
                </Grid.ColumnDefinitions>

                <!-- KPI-плитки -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Доходы -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="#F0FBF5">
                        <StackPanel>
                            <TextBlock Text="ДОХОДЫ" Style="{StaticResource KpiLabelStyle}"
                                       Foreground="#1F8A5B"/>
                            <TextBlock x:Name="IncomeTotalTextBlock"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="#1F8A5B"
                                       Text="—"/>
                        </StackPanel>
                    </Border>

                    <!-- Расходы -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="#FFF5F5F5">
                        <StackPanel>
                            <TextBlock Text="РАСХОДЫ" Style="{StaticResource KpiLabelStyle}"
                                       Foreground="#D32F2F"/>
                            <TextBlock x:Name="ExpenseTotalTextBlock"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="#D32F2F"
                                       Text="—"/>
                        </StackPanel>
                    </Border>

                    <!-- Баланс -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="#EEF4FF" Margin="0">
                        <StackPanel>
                            <TextBlock Text="БАЛАНС" Style="{StaticResource FieldLabelStyle}"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock x:Name="BalanceTotalTextBlock"
                                       Style="{StaticResource KpiValueStyle}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="—"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Кнопки действий -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">

                    <ComboBox x:Name="ExportFormatComboBox"
                              Width="110" Height="36"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Background="White"
                              BorderBrush="{StaticResource BorderBrush}">
                        <ComboBoxItem Content="CSV" IsSelected="True"/>
                        <ComboBoxItem Content="Word"/>
                        <ComboBoxItem Content="PDF"/>
                    </ComboBox>

                    <Button Content="Экспорт"
                            Width="105"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ExportButton_Click"/>

                    <Button Content="На почту"
                            Width="115"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="SendEmailReport_Click"/>

                    <Button Content="Назад"
                            Width="105"
                            Margin="0"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BackButton_Click"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>