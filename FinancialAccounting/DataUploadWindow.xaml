<Window x:Class="FinancialAccounting.DataUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка данных" Height="640" Width="980"
        Background="#FFF4F7FB"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="#1F2937">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush"         Color="#1565C0"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush"    Color="#0D47A1"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush"  Color="#0A3276"/>
        <SolidColorBrush x:Key="SecondaryBrush"       Color="#E8F0FE"/>
        <SolidColorBrush x:Key="SecondaryHoverBrush"  Color="#D8E7FD"/>
        <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#C6DBFC"/>
        <SolidColorBrush x:Key="GhostBrush"           Color="#EEF2F7"/>
        <SolidColorBrush x:Key="GhostHoverBrush"      Color="#E1E7EF"/>
        <SolidColorBrush x:Key="GhostPressedBrush"    Color="#D6DEE8"/>
        <SolidColorBrush x:Key="SuccessBrush"         Color="#1F8A5B"/>
        <SolidColorBrush x:Key="SuccessHoverBrush"    Color="#187149"/>
        <SolidColorBrush x:Key="SuccessPressedBrush"  Color="#115537"/>
        <SolidColorBrush x:Key="DangerBrush"          Color="#D32F2F"/>
        <SolidColorBrush x:Key="DangerHoverBrush"     Color="#B71C1C"/>
        <SolidColorBrush x:Key="DangerPressedBrush"   Color="#8E1616"/>
        <SolidColorBrush x:Key="SurfaceBrush"         Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush"          Color="#FFD7E0EA"/>
        <SolidColorBrush x:Key="MutedTextBrush"       Color="#FF6B7280"/>
        <SolidColorBrush x:Key="HeaderTextBrush"      Color="#FF111827"/>

        <!-- Общий стиль карточки — компактный -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Labels -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Base Button -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource GhostBrush}"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton -->
        <Style x:Key="UploadRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,7,0">
                                    <Ellipse Stroke="#94A3B8" StrokeThickness="1.5" Fill="White"/>
                                    <Ellipse x:Name="Dot" Width="8" Height="8"
                                             Fill="{StaticResource PrimaryBrush}" Opacity="0"/>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF3F6FA"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                    <Setter Property="Background" Value="#FFFFF7D6"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7FAFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8F0FE"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- Главный контейнер -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок + способ + фильтры -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Прогресс + кнопки -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — компактная шапка ═══ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка 1: заголовок + статус файла -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="Загрузка данных"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource HeaderTextBrush}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <TextBlock x:Name="txtFileName"
                               Text="Файл не выбран"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontStyle="Italic"
                               FontSize="12"
                               Margin="14,0,0,0"
                               DockPanel.Dock="Left"/>
                </DockPanel>

                <!-- Строка 2: способ загрузки + фильтры в одну линию -->
                <DockPanel Grid.Row="1" LastChildFill="False">

                    <!-- Способ загрузки -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Загрузка:"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <RadioButton Content="PDF / Excel"
                                     GroupName="UploadMethod"
                                     Style="{StaticResource UploadRadioStyle}"
                                     Checked="RadioButton_Checked"/>
                        <RadioButton Content="OFX"
                                     GroupName="UploadMethod"
                                     Style="{StaticResource UploadRadioStyle}"
                                     Checked="RadioButton_Checked_1"/>
                        <RadioButton Content="Ручной ввод"
                                     GroupName="UploadMethod"
                                     Style="{StaticResource UploadRadioStyle}"
                                     Checked="RadioButton_Checked_2"/>
                    </StackPanel>

                    <!-- Разделитель -->
                    <Rectangle DockPanel.Dock="Left"
                               Width="1" Fill="{StaticResource BorderBrush}"
                               Margin="18,0" VerticalAlignment="Stretch"/>

                    <!-- Фильтры -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Фильтр:"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  Width="165" Height="34"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Background="White"
                                  Foreground="#111827"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  SelectionChanged="CategoryComboBox_SelectionChanged">
                            <ComboBoxItem Content="Все категории" IsSelected="True"/>
                            <ComboBoxItem Content="Супермаркеты"/>
                            <ComboBoxItem Content="Переводы"/>
                        </ComboBox>

                        <TextBlock Text="с:"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Width="130" Height="34"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Background="White"
                                    SelectedDateChanged="FilterDatePicker_SelectedDateChanged"/>

                        <TextBlock Text="по:"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Width="130" Height="34"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Background="White"
                                    SelectedDateChanged="FilterDatePicker_SelectedDateChanged"/>
                    </StackPanel>

                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — таблица ═══ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="TransactionsGrid"
                      AutoGenerateColumns="False"
                      Background="White"
                      Foreground="#1F2937"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FFF9FBFD"
                      RowBackground="White"
                      RowStyle="{StaticResource GridRowStyle}"
                      ColumnHeaderStyle="{StaticResource GridColumnHeader}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата"      Binding="{Binding Date}"        Width="130"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}"    Width="*"/>
                    <DataGridTextColumn Header="Сумма"     Binding="{Binding Amount}"      Width="110"/>
                    <DataGridTextColumn Header="Остаток"   Binding="{Binding Balance}"     Width="110"/>
                    <DataGridTextColumn Header="Описание"  Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="Уверенность" Binding="{Binding MlConfidenceDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Источник" Binding="{Binding PredictionSource}" Width="120"/>
                    <DataGridTextColumn Header="Подсказка" Binding="{Binding SuggestedCategory}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ ROW 2 — прогресс + кнопки ═══ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
            <StackPanel>

                <!-- Прогресс -->
                <StackPanel Margin="0,0,0,10">
                    <ProgressBar x:Name="ProgressBar"
                                 Height="14"
                                 Minimum="0" Maximum="100"
                                 Visibility="Collapsed"
                                 Background="#FFE9EEF5"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 BorderThickness="0"/>
                    <TextBlock x:Name="ProgressText"
                               Text=""
                               Foreground="{StaticResource MutedTextBrush}"
                               FontStyle="Italic" FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Кнопки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Распознать чек"    Width="150" Style="{StaticResource SuccessButtonStyle}"   Click="UploadReceipt_Click"/>
                        <Button Content="Категоризация"     Width="135" Style="{StaticResource PrimaryButtonStyle}"   Click="Categorize_Click"/>
                        <Button Content="Принять подсказки" Width="160" Style="{StaticResource SuccessButtonStyle}"   Click="AcceptSuggestions_Click"/>
                        <Button Content="Уточнить через интернет" Width="205" Style="{StaticResource SecondaryButtonStyle}" Click="EnrichWeb_Click"/>
                        <Button Content="Обработать"        Width="120" Style="{StaticResource PrimaryButtonStyle}"   Click="Processing_Click"/>
                        <Button Content="Сохранить в БД"   Width="150" Style="{StaticResource PrimaryButtonStyle}"   Click="SaveDatabase_Click"/>
                        <Button Content="Очистить"          Width="105" Style="{StaticResource GhostButtonStyle}"    Click="Button_Click_2"/>
                        <Button Content="В OFX"             Width="90"  Style="{StaticResource SecondaryButtonStyle}" Click="ExportToOfx_Click"/>
                        <Button x:Name="btnTrainModel"
                                Content="Дообучить модель"
                                Width="155"
                                Visibility="Collapsed"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="TeachModel_Click"/>
                    </WrapPanel>

                    <Button Grid.Column="1"
                            Content="Назад"
                            Width="105"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="10,0,0,8"
                            VerticalAlignment="Bottom"
                            Click="BackButton_Click"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</Window>
