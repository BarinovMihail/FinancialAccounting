<Window x:Class="FinancialAccounting.BudgetManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление бюджетами"
        Width="620" Height="520"
        MinWidth="500" MinHeight="420"
        Background="#FFFDF9F3"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#222"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Управление бюджетами по категориям"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#C76A00"
                   Margin="0,0,0,12"/>

        <!-- Форма ввода -->
        <Border Grid.Row="1"
                Background="#FFF5F5F5"
                BorderBrush="#FFE0B2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория:" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Сумма бюджета:" Margin="10,0,0,4"/>

                <ComboBox x:Name="CategoryComboBox"
                          Grid.Row="1" Grid.Column="0"
                          Height="32"
                          Margin="0,0,10,0"/>

                <TextBox x:Name="BudgetAmountBox"
                         Grid.Row="1" Grid.Column="1"
                         Width="140" Height="32"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Padding="4,0"/>

                <Button Content="Сохранить"
                        Grid.Row="1" Grid.Column="2"
                        Width="110" Height="32"
                        Background="#FF9800"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="SaveBudget_Click"/>
            </Grid>
        </Border>

        <!-- Список бюджетов -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFE0B2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Установленные бюджеты"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#C76A00"
                           Margin="4,0,0,8"/>

                <ListView Grid.Row="1"
                          x:Name="BudgetListView"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding CategoryName}" Width="280"/>
                            <GridViewColumn Header="Бюджет" DisplayMemberBinding="{Binding AmountText}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Удалить"
                    Width="110" Height="34"
                    Background="#D84315"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    Click="DeleteBudget_Click"/>

            <Button Content="Закрыть"
                    Width="110" Height="34"
                    Background="#A25B00"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
