<Window x:Class="FinancialAccounting.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Аналитика"
        Width="1920" Height="1080"
        MinWidth="920" MinHeight="620"
        Background="#FFFDF9F3"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#222"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Аналитика по транзакциям"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#C76A00"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <Border Grid.Row="1"
                Background="#FFF5F5F5"
                BorderBrush="#FFE0B2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <WrapPanel ItemHeight="62">
                <StackPanel Width="170" Margin="0,0,10,0">
                    <TextBlock Text="Тип графика:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ChartTypeComboBox" Height="32">
                        <ComboBoxItem Content="Гистограмма" IsSelected="True"/>
                        <ComboBoxItem Content="Линейный график"/>
                        <ComboBoxItem Content="Круговая диаграмма"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="140" Margin="0,0,10,0">
                    <TextBlock Text="Тип операции:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeComboBox" Height="32">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="Доход"/>
                        <ComboBoxItem Content="Расход"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,10,0">
                    <TextBlock Text="Категория:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryComboBox" Height="32"/>
                </StackPanel>

                <StackPanel Width="150" Margin="0,0,10,0">
                    <TextBlock Text="Дата с:" Margin="0,0,0,4"/>
                    <DatePicker x:Name="StartDatePicker" Height="32"/>
                </StackPanel>

                <StackPanel Width="150" Margin="0,0,10,0">
                    <TextBlock Text="По:" Margin="0,0,0,4"/>
                    <DatePicker x:Name="EndDatePicker" Height="32"/>
                </StackPanel>

                <Button Content="Построить"
                        Width="120" Height="32"
                        Margin="0,22,0,0"
                        Background="#FF5722"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="BuildChart_Click"/>
            </WrapPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <!-- Вкладка 1: графики + анализ -->
            <TabItem Header="Графики и анализ">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <!-- Графики -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <lvc:CartesianChart x:Name="MainChart" Visibility="Visible">
                                <lvc:CartesianChart.DataTooltip>
                                    <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                </lvc:CartesianChart.DataTooltip>
                            </lvc:CartesianChart>

                            <lvc:PieChart x:Name="PieChart" Visibility="Collapsed" LegendLocation="Bottom">
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                </lvc:PieChart.DataTooltip>
                            </lvc:PieChart>
                        </Grid>
                    </Border>

                    <!-- Анализ -->
                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Анализ данных"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#C76A00"
                                       Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="NeuroAnalysisText"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Text="Анализ данных будет отображён здесь..." />
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Запросить анализ"
                                        Width="160" Height="32"
                                        Background="#FF9800"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Click="GenerateAnalysis_Click"/>

                                <Button Grid.Column="1"
                                        Content="На весь экран"
                                        Width="150" Height="32"
                                        Margin="10,0,0,0"
                                        Click="OpenAnalysisFullScreen_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: мини-дашборд -->
            <TabItem Header="Дашборд">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                        <Border CornerRadius="8" BorderBrush="#FFE0B2" BorderThickness="1" Padding="10" Margin="0,0,10,10" Background="White">
                            <StackPanel>
                                <TextBlock Text="Самый большой доход" Foreground="#C76A00" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MaxIncomeText" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock x:Name="MaxIncomeDateText" Opacity="0.75"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" BorderBrush="#FFE0B2" BorderThickness="1" Padding="10" Margin="0,0,10,10" Background="White">
                            <StackPanel>
                                <TextBlock Text="Самый большой расход" Foreground="#C76A00" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MaxExpenseText" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock x:Name="MaxExpenseDateText" Opacity="0.75"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" BorderBrush="#FFE0B2" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White">
                            <StackPanel>
                                <TextBlock Text="Популярный супермаркет" Foreground="#C76A00" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TopMarketText" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TopMarketSumText" Opacity="0.75"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Контент, который заполняет всё оставшееся место -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top-5 расходов: растягивается по высоте -->
                        <Border Grid.Column="0"
                    Background="White" BorderBrush="#FFE0B2" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Топ‑5 категорий расходов"
                               FontSize="16" FontWeight="Bold" Foreground="#C76A00"
                               Margin="0,0,0,8"/>

                                <lvc:CartesianChart Grid.Row="1"
                                       x:Name="Top5ExpensesChart"
                                       MinHeight="260"
                                       VerticalAlignment="Stretch">
                                    <lvc:CartesianChart.DataTooltip>
                                        <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                    </lvc:CartesianChart.DataTooltip>
                                </lvc:CartesianChart>
                            </Grid>
                        </Border>

                        <!-- Правая панель: список топ супермаркетов заполняет высоту -->
                        <Border Grid.Column="1"
                    Background="White" BorderBrush="#FFE0B2" BorderThickness="1"
                    CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Топ супермаркетов (5)"
                               FontSize="16" FontWeight="Bold" Foreground="#C76A00"
                               Margin="0,0,0,8"/>

                                <ListView Grid.Row="1" x:Name="TopMarketsList">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Магазин" DisplayMemberBinding="{Binding Merchant}" Width="160"/>
                                            <GridViewColumn Header="Чеков" DisplayMemberBinding="{Binding Count}" Width="60"/>
                                            <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding SumText}" Width="90"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <Button Grid.Row="3"
                Content="Назад"
                Width="110" Height="34"
                Background="#A25B00"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Click="BackButton_Click"/>
    </Grid>
</Window>
