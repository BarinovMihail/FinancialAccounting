<Window x:Class="FinancialAccounting.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Аналитика"
        Width="1920" Height="1080"
        MinWidth="920" MinHeight="620"
        Background="#FFFDF9F3"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#222"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Аналитика по транзакциям"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#C76A00"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <Border Grid.Row="1"
                Background="#FFF5F5F5"
                BorderBrush="#FFE0B2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <WrapPanel ItemHeight="62">
                <StackPanel Width="170" Margin="0,0,10,0">
                    <TextBlock Text="Тип графика:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ChartTypeComboBox" Height="32">
                        <ComboBoxItem Content="Гистограмма" IsSelected="True"/>
                        <ComboBoxItem Content="Линейный график"/>
                        <ComboBoxItem Content="Круговая диаграмма"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="140" Margin="0,0,10,0">
                    <TextBlock Text="Тип операции:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeComboBox" Height="32">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="Доход"/>
                        <ComboBoxItem Content="Расход"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,10,0">
                    <TextBlock Text="Категория:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryComboBox" Height="32"/>
                </StackPanel>

                <StackPanel Width="150" Margin="0,0,10,0">
                    <TextBlock Text="Дата с:" Margin="0,0,0,4"/>
                    <DatePicker x:Name="StartDatePicker" Height="32"/>
                </StackPanel>

                <StackPanel Width="150" Margin="0,0,10,0">
                    <TextBlock Text="По:" Margin="0,0,0,4"/>
                    <DatePicker x:Name="EndDatePicker" Height="32"/>
                </StackPanel>

                <Button Content="Построить"
                        Width="120" Height="32"
                        Margin="0,22,0,0"
                        Background="#FF5722"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="BuildChart_Click"/>
            </WrapPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" Margin="0,10,0,0" SelectionChanged="TabControl_SelectionChanged">
            <!-- Вкладка 1: графики + анализ -->
            <TabItem Header="Графики и анализ">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <!-- Графики -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <lvc:CartesianChart x:Name="MainChart" Visibility="Visible">
                                <lvc:CartesianChart.DataTooltip>
                                    <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                </lvc:CartesianChart.DataTooltip>
                            </lvc:CartesianChart>

                            <lvc:PieChart x:Name="PieChart" Visibility="Collapsed" LegendLocation="Bottom">
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                </lvc:PieChart.DataTooltip>
                            </lvc:PieChart>
                        </Grid>
                    </Border>

                    <!-- Умные рекомендации — AI-ассистент -->
                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Умные рекомендации"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#C76A00"
                                       Margin="0,0,0,6"/>

                            <!-- Быстрые вопросы -->
                            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button Content="На что я трачу больше всего?"
                                        Margin="0,0,6,4" Padding="8,4"
                                        Background="#FFE0B2" BorderThickness="0"
                                        FontSize="12" Click="QuickPrompt_Click"/>
                                <Button Content="Как сократить расходы?"
                                        Margin="0,0,6,4" Padding="8,4"
                                        Background="#FFE0B2" BorderThickness="0"
                                        FontSize="12" Click="QuickPrompt_Click"/>
                                <Button Content="Есть ли аномальные траты?"
                                        Margin="0,0,6,4" Padding="8,4"
                                        Background="#FFE0B2" BorderThickness="0"
                                        FontSize="12" Click="QuickPrompt_Click"/>
                                <Button Content="Какие категории самые затратные?"
                                        Margin="0,0,6,4" Padding="8,4"
                                        Background="#FFE0B2" BorderThickness="0"
                                        FontSize="12" Click="QuickPrompt_Click"/>
                                <Button Content="Дай рекомендации по бюджету"
                                        Margin="0,0,6,4" Padding="8,4"
                                        Background="#FFE0B2" BorderThickness="0"
                                        FontSize="12" Click="QuickPrompt_Click"/>
                            </WrapPanel>

                            <!-- Область чата -->
                            <ScrollViewer Grid.Row="2"
                                          x:Name="ChatScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,0,0,8">
                                <ItemsControl x:Name="ChatItemsControl">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4"
                                                    Padding="10,8"
                                                    CornerRadius="10"
                                                    MaxWidth="600">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFF5EDE0"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                                <Setter Property="Background" Value="#FFEDBA"/>
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               FontSize="13"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="10"
                                                               Opacity="0.5"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Поле ввода + кнопки -->
                            <Grid Grid.Row="3" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="UserInputBox"
                                         Grid.Column="0"
                                         Height="34"
                                         Padding="8,6"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         KeyDown="UserInputBox_KeyDown"/>

                                <Button x:Name="SendButton"
                                        Grid.Column="1"
                                        Content="Отправить"
                                        Width="100" Height="34"
                                        Margin="8,0,0,0"
                                        Background="#FF9800"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Click="SendAssistantMessage_Click"/>
                            </Grid>

                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Очистить чат"
                                        Width="110" Height="28"
                                        Background="#A25B00"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Click="ClearChat_Click"/>
                                <Button Content="На весь экран"
                                        Width="120" Height="28"
                                        Margin="8,0,0,0"
                                        Click="OpenAnalysisFullScreen_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: мини-дашборд -->
            <TabItem Header="Дашборд">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                        <Border CornerRadius="8" BorderBrush="#FFE0B2" BorderThickness="1" Padding="10" Margin="0,0,10,10" Background="White">
                            <StackPanel>
                                <TextBlock Text="Самый большой доход" Foreground="#C76A00" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MaxIncomeText" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock x:Name="MaxIncomeDateText" Opacity="0.75"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" BorderBrush="#FFE0B2" BorderThickness="1" Padding="10" Margin="0,0,10,10" Background="White">
                            <StackPanel>
                                <TextBlock Text="Самый большой расход" Foreground="#C76A00" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MaxExpenseText" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock x:Name="MaxExpenseDateText" Opacity="0.75"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" BorderBrush="#FFE0B2" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White">
                            <StackPanel>
                                <TextBlock Text="Популярный супермаркет" Foreground="#C76A00" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TopMarketText" FontSize="18" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TopMarketSumText" Opacity="0.75"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Контент, который заполняет всё оставшееся место -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top-5 расходов: растягивается по высоте -->
                        <Border Grid.Column="0"
                    Background="White" BorderBrush="#FFE0B2" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Топ‑5 категорий расходов"
                               FontSize="16" FontWeight="Bold" Foreground="#C76A00"
                               Margin="0,0,0,8"/>

                                <lvc:CartesianChart Grid.Row="1"
                                       x:Name="Top5ExpensesChart"
                                       MinHeight="260"
                                       VerticalAlignment="Stretch">
                                    <lvc:CartesianChart.DataTooltip>
                                        <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                    </lvc:CartesianChart.DataTooltip>
                                </lvc:CartesianChart>
                            </Grid>
                        </Border>

                        <!-- Правая панель: список топ супермаркетов заполняет высоту -->
                        <Border Grid.Column="1"
                    Background="White" BorderBrush="#FFE0B2" BorderThickness="1"
                    CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Топ супермаркетов (5)"
                               FontSize="16" FontWeight="Bold" Foreground="#C76A00"
                               Margin="0,0,0,8"/>

                                <ListView Grid.Row="1" x:Name="TopMarketsList">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Магазин" DisplayMemberBinding="{Binding Merchant}" Width="160"/>
                                            <GridViewColumn Header="Чеков" DisplayMemberBinding="{Binding Count}" Width="60"/>
                                            <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding SumText}" Width="90"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: бюджеты по категориям -->
            <TabItem Header="БЮДЖЕТЫ ПО КАТЕГОРИЯМ">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Управление бюджетами"
                            Width="200" Height="34"
                            HorizontalAlignment="Left"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Margin="0,0,0,10"
                            Click="OpenBudgetManagement_Click"/>

                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Сравнение расходов и бюджетов по категориям"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#C76A00"
                                       Margin="0,0,0,8"/>

                            <lvc:CartesianChart Grid.Row="1"
                                                x:Name="BudgetComparisonChart"
                                                MinHeight="300">
                                <lvc:CartesianChart.DataTooltip>
                                    <lvc:DefaultTooltip SelectionMode="OnlySender" />
                                </lvc:CartesianChart.DataTooltip>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <Button Grid.Row="3"
                Content="Назад"
                Width="110" Height="34"
                Background="#A25B00"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Click="BackButton_Click"/>
    </Grid>
</Window>
